# ---------------------------------------------------------------------------
# Database (Postgres). On Vercel, add a Neon/Supabase/Vercel Postgres store and
# copy both URLs here. DIRECT_URL is the non-pooled connection used by migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/honchar?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/honchar?sslmode=require"

# ---------------------------------------------------------------------------
# Session signing key. Must be at least 24 characters and kept secret.
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Photo uploads. Set this on Vercel (Storage -> Blob -> connect) so uploads go
# to Blob storage. Leave it unset locally and photos are written to
# public/uploads instead.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---------------------------------------------------------------------------
# Optional: credentials created by `npm run db:seed` for the first owner login.
# ---------------------------------------------------------------------------
# SEED_ADMIN_EMAIL="owner@honcharcollective.com"
# SEED_ADMIN_PASSWORD="change-me"

# ---------------------------------------------------------------------------
# Public site URL, used for canonical links, the sitemap, and link previews.
# Set this to the live domain once it's pointed at the site. Before then,
# Vercel's own deployment URL is used automatically.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL="https://honcharcollective.com"

# ---------------------------------------------------------------------------
# Optional. On a test deployment with a public URL and no password in front of
# it, set this to the email allowed to claim the owner account — the first-run
# setup form then rejects everyone else. Leave unset for normal deployments.
# ---------------------------------------------------------------------------
# SETUP_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# New-enquiry notifications. Both channels are optional and independent — set
# either, both, or neither. With neither set, enquiries are still saved and
# still appear under Leads in the dashboard; nobody is just pinged about them.
#
# A failed notification never fails the enquiry, so a wrong key here loses a
# ping, not a customer.
#
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook, then
# copy the URL. Fastest option — it push-notifies a phone with no domain setup.
# ---------------------------------------------------------------------------
# LEAD_NOTIFY_DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."

# ---------------------------------------------------------------------------
# Email, via Resend (resend.com — free tier covers a boutique's volume).
# LEAD_NOTIFY_EMAIL takes a comma-separated list to notify several people.
#
# LEAD_NOTIFY_FROM must be an address at a domain verified in Resend. Until
# that's set up, leaving it unset sends from Resend's shared test sender, which
# only delivers to the address that owns the Resend account.
# ---------------------------------------------------------------------------
# RESEND_API_KEY="re_..."
# LEAD_NOTIFY_EMAIL="hola@honcharcollective.com"
# LEAD_NOTIFY_FROM="Honchar Collective <leads@honcharcollective.com>"

# ---------------------------------------------------------------------------
# Meta (Facebook) tracking.
#
# Off by default. Set NEXT_PUBLIC_META_PIXEL_ID to the Collective's own
# dataset id to switch Meta tracking on.
#
# META_CAPI_TOKEN turns on the server-side half (Conversions API), which reports
# leads the browser pixel loses to ad blockers and tracking prevention. Generate
# it in Events Manager -> Settings -> Conversions API -> Generate access token.
# Both halves send the lead's id as the event id, so Meta collapses the pair
# instead of counting each enquiry twice.
#
# META_API_VERSION only matters if Meta retires the pinned Graph API version;
# the error logged by lib/meta.ts will say so.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_META_PIXEL_ID="your-dataset-id"
# META_CAPI_TOKEN="EAA..."
# META_API_VERSION="v21.0"
